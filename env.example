# Email provider selection: smtp | gmail | outlook | yahoo | zoho
MAIL_PROVIDER=smtp

# SMTP auth (required for all providers)
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_password_or_app_password

# SMTP host/port (required when MAIL_PROVIDER=smtp, optional override otherwise)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Sender identity used by nodemailer
MAIL_FROM_NAME=Roshan Portfolio
MAIL_FROM_EMAIL=your_verified_sender_email@example.com

# Where you want to receive contact form emails
CONTACT_TO_EMAIL=your_destination_email@example.com

# Public link to your primary resume (used in hero)
NEXT_PUBLIC_RESUME_LINK=https://your-public-resume-link.com

# Server-side weather proxy for terminal command: `weather <city>`
OPENWEATHER_API_KEY=your_openweather_api_key

# Google Drive service account (for optional PDF uploads from the resume wizard)
GOOGLE_CLIENT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# One Drive folder ID per role
GOOGLE_DRIVE_FOLDER_FSD=drive_folder_id_for_full_stack_developer
GOOGLE_DRIVE_FOLDER_BD=drive_folder_id_for_backend_developer
GOOGLE_DRIVE_FOLDER_FD=drive_folder_id_for_frontend_developer
GOOGLE_DRIVE_FOLDER_SDE=drive_folder_id_for_sde
GOOGLE_DRIVE_FOLDER_DS=drive_folder_id_for_ml_ds_engineer
GOOGLE_DRIVE_FOLDER_AI=drive_folder_id_for_ai_engineer
GOOGLE_DRIVE_FOLDER_AIB=drive_folder_id_for_ai_backend_engineer

# Vapi web voice widget
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id
